PORT=5000
NODE_ENV=development
MONGODB_URI=
MONGODB_DB=akshaya_patra
# Use a different MongoDB deployment from MONGODB_URI for an active full-database mirror.
# The primary MongoDB deployment must support change streams (for example, Atlas replica sets).
MONGODB_BACKUP_URI=
MONGODB_BACKUP_DB=akshaya_patra_backup
OTP_HASH_SECRET=
JWT_SECRET=
# Long random secret used only by trusted staff to provision, approve, or suspend sellers.
SELLER_ADMIN_KEY=
# Initial administrator credentials. The first successful sign-in requires a password change.
ADMIN_USERNAME=
ADMIN_INITIAL_PASSWORD=
ADMIN_EMAIL=
ADMIN_MOBILE=
# Separate 32+ character recovery secret. Never put this in frontend or seller app settings.
ADMIN_RESET_CODE=
# development exposes the recovery OTP in the admin screen. Never use in production.
ADMIN_OTP_MODE=
ADMIN_SMS_ACCOUNT_SID=
ADMIN_SMS_AUTH_TOKEN=
ADMIN_SMS_FROM=
# Set to development to return the OTP in the API response for temporary testing.
# Set to smtp in production after SMTP is configured.
OTP_DELIVERY_MODE=development
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

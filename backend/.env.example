PORT=5000
NODE_ENV=development
MONGODB_URI=
MONGODB_DB=akshaya_patra
# Use a different MongoDB deployment from MONGODB_URI for an active catalog mirror.
MONGODB_BACKUP_URI=
MONGODB_BACKUP_DB=akshaya_patra_backup
OTP_HASH_SECRET=
JWT_SECRET=
# Set to development to return the OTP in the API response for temporary testing.
# Set to smtp in production after SMTP is configured.
OTP_DELIVERY_MODE=development
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
